---
import heroSvg from '../assets/hero-illustration.svg?raw';
---

<section class="hero">
  <!-- Full-bleed visual on desktop -->
  <div class="hero__visual">
    <div class="hero__image-wrap" set:html={heroSvg} />
  </div>
  <div class="hero__content">
    <p class="hero__eyebrow">The Future of Digital Experiences</p>
    <h1 class="hero__title">
      Redefining <br aria-hidden="true" />Navigation, Heritage and Virtual Spaces <br aria-hidden="true" /> with AI-Powered Innovation.
    </h1>
    <div class="hero__actions">
      <a href="#solutions" class="hero__btn hero__btn--primary">Explore Solutions</a>
      <a href="#contact" class="hero__btn hero__btn--secondary">Get in Touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
  }

  .hero {
    overflow: hidden;
  }


  /* Desktop: visual fills hero, content sits bottom-right */
  .hero__visual {
    position: absolute;
    inset: 0;
  }

  .hero__image-wrap {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .hero__image-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  .hero__image-wrap :global(svg) {
    /* Desktop: pin to bottom-left so left side of illustration is visible */
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    object-fit: contain;
    animation: hero-svg-reveal 2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @media (max-width: 768px) {
    .hero__image-wrap :global(svg) {
      position: relative;
      left: auto;
      bottom: auto;
      /* Center; render larger to avoid blur */
      width: 160%;
      height: 160%;
      min-width: 160%;
      min-height: 160%;
      flex-shrink: 0;
    }
  }

  .hero__image-wrap :global(.hero-svg-part) {
    opacity: 0;
    animation: hero-part-reveal 0.4s ease-out forwards;
  }

  @keyframes hero-svg-reveal {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes hero-part-reveal {
    to {
      opacity: 1;
    }
  }

  .hero__content {
    position: absolute;
    bottom: var(--s-8);
    right: var(--s-8);
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    max-width: 66rem;
    text-align: right;
  }

  @media (max-width: 768px) {
    .hero__content {
      bottom: var(--s-8);
      left: var(--s-5);
      right: var(--s-5);
      padding: 0;
      max-width: none;
      align-items: flex-start;
      text-align: left;
    }
  }

  .hero__eyebrow {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-text-muted);
  }

  @media (max-width: 768px) {
    .hero__eyebrow {
      font-size: var(--text-xs);
    }
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: clamp(1.625rem, 5vw, 2.75rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--c-text);
  }

  @media (max-width: 768px) {
    .hero__title br {
      display: none;
    }
  }

  .hero__actions {
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  @media (max-width: 768px) {
    .hero__actions {
      justify-content: flex-start;
    }
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-3) var(--s-6);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--r-md);
    transition: opacity 0.2s, background 0.2s, transform 0.15s;
  }

  .hero__btn:hover {
    opacity: 0.9;
  }

  .hero__btn:active {
    transform: scale(0.98);
  }

  .hero__btn:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .hero__btn--primary {
    background: var(--c-accent);
    color: var(--c-bg);
  }

  .hero__btn--secondary {
    background: var(--c-surface);
    color: var(--c-text);
    border: 1px solid var(--c-border);
  }

  @media (max-width: 480px) {
    .hero__btn {
      font-size: var(--text-sm);
      padding: var(--s-3) var(--s-5);
    }
  }
</style>
