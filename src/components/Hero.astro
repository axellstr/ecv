---
---

<section class="hero">
  <!-- Full-bleed visual on desktop -->
  <div class="hero__visual">
    <div class="hero__placeholder"></div>
  </div>
  <div class="hero__content">
    <p class="hero__eyebrow">The Future of Digital Experiences</p>
    <h1 class="hero__title">
      Redefining <br>Navigation, Heritage and Virtual Spaces <br> with AI-Powered Innovation.
    </h1>
    <div class="hero__actions">
      <a href="#work" class="hero__btn hero__btn--primary">Explore Solutions</a>
      <a href="#contact" class="hero__btn hero__btn--secondary">Get in Touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
  }

  @media (min-width: 769px) {
    .hero {
      overflow: hidden;
    }
  }

  @media (max-width: 768px) {
    .hero {
      display: flex;
      flex-direction: column;
      text-align: center;
    }
  }

  /* Desktop: visual fills hero, content sits bottom-right */
  .hero__visual {
    position: absolute;
    inset: 0;
  }

  .hero__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__placeholder::after {
    content: '[3D / visual placeholder]';
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    font-family: var(--font-sans);
  }

  .hero__content {
    position: absolute;
    bottom: var(--s-8);
    right: var(--s-8);
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    max-width: 66rem;
    text-align: right;
  }

  @media (max-width: 768px) {
    .hero__visual {
      position: relative;
      min-height: 18rem;
    }

    .hero__placeholder {
      min-height: 18rem;
      border: 1px dashed var(--c-border);
      border-radius: var(--r-lg);
    }

    .hero__content {
      position: relative;
      bottom: auto;
      right: auto;
      padding: var(--s-8);
      max-width: none;
      align-items: center;
      text-align: center;
    }
  }

  .hero__eyebrow {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-text-muted);
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-xl), 5vw, 2.5rem);
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
    color: var(--c-text);
  }

  .hero__actions {
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  @media (max-width: 768px) {
    .hero__actions {
      justify-content: center;
    }
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-3) var(--s-6);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--r-md);
    transition: opacity 0.2s, background 0.2s;
  }

  .hero__btn:hover {
    opacity: 0.9;
  }

  .hero__btn--primary {
    background: var(--c-accent);
    color: var(--c-bg);
  }

  .hero__btn--secondary {
    background: var(--c-surface);
    color: var(--c-text);
    border: 1px solid var(--c-border);
  }
</style>
