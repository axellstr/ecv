---
interface Props {
  headline?: string;
  subheadline?: string;
  primaryCta?: string;
  primaryCtaHref?: string;
  secondaryCta?: string;
  secondaryCtaHref?: string;
}

const {
  headline = "We create brands and experiences that resonate.",
  subheadline = "A full-service agency focused on strategy, design, and execution.",
  primaryCta = "Get in touch",
  primaryCtaHref = "#contact",
  secondaryCta = "View our work",
  secondaryCtaHref = "#",
} = Astro.props;
---

<section class="hero">
  <div class="hero__inner">
    <h1 class="hero__headline">{headline}</h1>
    <p class="hero__subheadline">{subheadline}</p>
    <div class="hero__ctas">
      <a href={primaryCtaHref} class="hero__cta hero__cta--primary">{primaryCta}</a>
      <a href={secondaryCtaHref} class="hero__cta hero__cta--secondary">{secondaryCta}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-section) var(--spacing-block);
    background: linear-gradient(180deg, var(--color-bg) 0%, #f5f5f4 100%);
  }

  .hero__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    text-align: center;
  }

  .hero__headline {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 var(--spacing-block);
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .hero__headline {
      font-size: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero__headline {
      font-size: 4rem;
    }
  }

  .hero__subheadline {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 36rem;
    margin: 0 auto var(--spacing-block);
  }

  @media (min-width: 768px) {
    .hero__subheadline {
      font-size: 1.25rem;
    }
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
  }

  .hero__cta {
    display: inline-block;
    padding: 1rem 2rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.25rem;
    transition: background-color 0.2s, color 0.2s;
  }

  .hero__cta--primary {
    background-color: var(--color-accent);
    color: white;
  }

  .hero__cta--primary:hover {
    background-color: var(--color-accent-hover);
  }

  .hero__cta--secondary {
    background-color: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-border);
  }

  .hero__cta--secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
