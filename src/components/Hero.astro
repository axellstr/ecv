---
---

<section class="hero">
  <!-- Full-bleed visual on desktop -->
  <div class="hero__visual">
    <div class="hero__image-wrap" id="hero-visual"></div>
  </div>
  <div class="hero__content">
    <p class="hero__eyebrow">The Future of Digital Experiences</p>
    <h1 class="hero__title">
      Redefining <br aria-hidden="true" />Navigation, Heritage and Virtual Spaces <br aria-hidden="true" /> with AI-Powered Innovation.
    </h1>
    <div class="hero__actions">
      <a href="#solutions" class="hero__btn hero__btn--primary">Explore Solutions</a>
      <a href="#contact" class="hero__btn hero__btn--secondary">Get in Touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
  }

  .hero__visual {
    position: absolute;
    inset: 0;
  }

  .hero__image-wrap {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .hero__image-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  .hero__image-wrap :global(svg) {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    object-fit: contain;
    animation: hero-svg-reveal 2s var(--ease-out) forwards;
  }

  @media (max-width: 768px) {
    .hero__image-wrap :global(svg) {
      position: relative;
      left: auto;
      bottom: auto;
      width: 160%;
      height: 160%;
      min-width: 160%;
      min-height: 160%;
      flex-shrink: 0;
    }
  }

  .hero__image-wrap :global(.hero-svg-part) {
    opacity: 0;
    animation: hero-part-reveal 0.4s ease-out forwards;
  }

  @keyframes hero-svg-reveal {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes hero-part-reveal {
    to { opacity: 1; }
  }

  .hero__content {
    position: absolute;
    bottom: var(--s-12);
    right: var(--s-10);
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    max-width: 66rem;
    text-align: right;
  }

  @media (max-width: 768px) {
    .hero__content {
      bottom: var(--s-10);
      left: var(--s-5);
      right: var(--s-5);
      padding: 0;
      max-width: none;
      align-items: flex-start;
      text-align: left;
    }
  }

  .hero__eyebrow {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent-primary);
    opacity: 0.85;
  }

  @media (max-width: 768px) {
    .hero__eyebrow {
      font-size: var(--text-xs);
    }
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: clamp(1.625rem, 5vw, 2.75rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--c-text);
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 768px) {
    .hero__title br {
      display: none;
    }
  }

  .hero__actions {
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
    justify-content: flex-end;
    padding-top: var(--s-2);
  }

  @media (max-width: 768px) {
    .hero__actions {
      justify-content: flex-start;
    }
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-3) var(--s-6);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.03em;
    text-decoration: none;
    border-radius: var(--r-lg);
    transition:
      background var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      transform var(--duration-fast) ease,
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .hero__btn:active {
    transform: scale(0.97);
  }

  .hero__btn:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .hero__btn--primary {
    background: var(--accent-primary);
    color: #0a0a0a;
    border: 1px solid var(--accent-primary);
  }

  .hero__btn--primary:hover {
    background: var(--accent-primary-hover);
    border-color: var(--accent-primary-hover);
    box-shadow: 0 0 24px rgba(217, 255, 0, 0.2);
    transform: translateY(-1px);
  }

  .hero__btn--secondary {
    background: rgba(255, 255, 255, 0.06);
    color: var(--c-text);
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .hero__btn--secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-1px);
  }

  @media (max-width: 480px) {
    .hero__btn {
      font-size: var(--text-xs);
      padding: var(--s-3) var(--s-5);
    }
  }
</style>

<script>
  const container = document.getElementById('hero-visual');
  if (container) {
    fetch('/images/hero-illustration.svg')
      .then((r) => r.text())
      .then((svg) => {
        container.innerHTML = svg;
      })
      .catch(() => {});
  }
</script>
