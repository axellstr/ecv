---
import { Send, Linkedin, Mail, MapPin, ArrowUp } from '@lucide/astro';

const X_LOGO_PATH = 'M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z';
const DISCORD_LOGO_PATH = 'M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z';

const socials = [
  { href: 'https://x.com/ECVPlatform', label: 'X', svgPath: X_LOGO_PATH },
  { href: 'https://t.me/ECVPlatform', label: 'Telegram', icon: Send },
  { href: 'https://www.linkedin.com/company/e-compvenience/', label: 'LinkedIn', icon: Linkedin },
  { href: 'https://discord.com/invite/UTHNdWvDY6', label: 'Discord', svgPath: DISCORD_LOGO_PATH },
];

const navColumns = [
  {
    title: 'Platform',
    links: [
      { label: 'About ECV', href: '#about' },
      { label: 'Solutions', href: '#solutions' },
      { label: 'Digital Twins', href: '#digital-twins' },
    ],
  },
  {
    title: 'Explore',
    links: [
      { label: 'Interactive Model', href: '#interactive-model' },
      { label: 'Use Cases', href: '#use-cases' },
      { label: 'Contact', href: '#contact' },
    ],
  },
];
---

<footer class="footer">
  <div class="footer__container">
    <div class="footer__grid">
      <!-- Brand column -->
      <div class="footer__brand">
        <a href="#" class="footer__logo-link" aria-label="E-Compvenience home">
          <img src="/icons/ecv.svg" alt="E-Compvenience" class="footer__logo" width="108" height="36" />
        </a>
        <p class="footer__tagline">
          Spatial technology &amp; digital twins powering the next generation of immersive experiences.
        </p>
        <div class="footer__socials">
          {socials.map((item) => (
            <a href={item.href} target="_blank" rel="noopener noreferrer" class="footer__social-link" aria-label={item.label}>
              {item.svgPath ? (
                <svg class="footer__social-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={item.svgPath} />
                </svg>
              ) : (
                <item.icon size={18} stroke-width={2} aria-hidden="true" />
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Navigation columns -->
      {navColumns.map((col) => (
        <nav class="footer__nav-col" aria-label={`${col.title} links`}>
          <h3 class="footer__nav-heading">{col.title}</h3>
          <ul class="footer__nav-list">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="footer__link">{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <!-- Contact column -->
      <div class="footer__contact">
        <h3 class="footer__nav-heading">Get in touch</h3>
        <ul class="footer__contact-list">
          <li class="footer__contact-item">
            <Mail size={16} stroke-width={2} aria-hidden="true" />
            <a href="mailto:info@e-compvenience.com" class="footer__contact-link">
              info@e-compvenience.com
            </a>
          </li>
          <li class="footer__contact-item">
            <MapPin size={16} stroke-width={2} aria-hidden="true" />
            <span class="footer__contact-text">Nicosia, Cyprus</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer__bottom">
      <p class="footer__copy">&copy; {new Date().getFullYear()} E-Compvenience. All rights reserved.</p>
      <button class="footer__back-to-top" aria-label="Back to top" type="button">
        <ArrowUp size={16} stroke-width={2.5} aria-hidden="true" />
        <span>Top</span>
      </button>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-surface);
    border-top: 1px solid var(--c-border);
  }

  .footer__container {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--s-20) var(--s-8) var(--s-10);
  }

  /* ── Grid layout ──────────────────────────────────────────────── */

  .footer__grid {
    display: grid;
    gap: var(--s-10) var(--s-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 540px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 900px) {
    .footer__grid {
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
      gap: var(--s-12) var(--s-10);
    }

    .footer__brand {
      grid-column: auto;
    }
  }

  /* ── Brand ────────────────────────────────────────────────────── */

  .footer__logo-link {
    display: inline-block;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .footer__logo-link:hover {
    opacity: 0.8;
  }

  .footer__logo {
    display: block;
    height: 2rem;
    width: auto;
  }

  .footer__tagline {
    margin: var(--s-5) 0 0;
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    line-height: 1.65;
    max-width: 28ch;
  }

  .footer__socials {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-lg);
    border: 1px solid var(--c-border);
    color: var(--c-text-muted);
    transition:
      color var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-spring);
  }

  .footer__social-link:hover {
    color: var(--accent-primary);
    border-color: rgba(217, 255, 0, 0.3);
    background: var(--accent-glow);
    transform: translateY(-2px);
  }

  .footer__social-link:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .footer__social-icon {
    display: block;
    flex-shrink: 0;
  }

  /* ── Navigation columns ───────────────────────────────────────── */

  .footer__nav-heading {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text);
    margin: 0 0 var(--s-5);
  }

  .footer__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .footer__link {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    text-decoration: none;
    transition: color var(--duration-normal) var(--ease-out);
  }

  .footer__link:hover {
    color: var(--c-text);
  }

  /* ── Contact column ───────────────────────────────────────────── */

  .footer__contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .footer__contact-item {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--c-text-muted);
  }

  .footer__contact-link {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    text-decoration: none;
    transition: color var(--duration-normal) var(--ease-out);
  }

  .footer__contact-link:hover {
    color: var(--c-text);
  }

  .footer__contact-text {
    font-size: var(--text-sm);
  }

  /* ── Bottom bar ───────────────────────────────────────────────── */

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--s-16);
    padding-top: var(--s-8);
    border-top: 1px solid var(--c-border);
    gap: var(--s-4);
  }

  .footer__copy {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--c-text-muted);
    opacity: 0.8;
  }

  .footer__back-to-top {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    background: none;
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    padding: var(--s-2) var(--s-4);
    color: var(--c-text-muted);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
    min-height: 2.25rem;
  }

  .footer__back-to-top:hover {
    color: var(--c-text);
    border-color: var(--c-border-hover);
    background: var(--c-surface-elevated);
    transform: translateY(-1px);
  }

  .footer__back-to-top:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  /* ── Mobile tweaks ────────────────────────────────────────────── */

  @media (max-width: 539px) {
    .footer__container {
      padding: var(--s-16) var(--s-5) var(--s-8);
    }

    .footer__socials {
      justify-content: flex-start;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--s-3);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.querySelector('.footer__back-to-top');
    if (btn) {
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  });
</script>
