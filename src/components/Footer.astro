---
import { Send, Linkedin } from '@lucide/astro';

const X_LOGO_PATH = 'M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z';
const DISCORD_LOGO_PATH = 'M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z';

const socials = [
  { href: 'https://x.com/ECVPlatform', label: 'X', svgPath: X_LOGO_PATH },
  { href: 'https://t.me/ECVPlatform', label: 'Telegram', icon: Send },
  { href: 'https://www.linkedin.com/company/e-compvenience/', label: 'LinkedIn', icon: Linkedin },
  { href: 'https://discord.com/invite/UTHNdWvDY6', label: 'Discord', svgPath: DISCORD_LOGO_PATH },
];
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <a href="#" class="footer__logo-link" aria-label="E-Compvenience home">
        <img src="/ecv.svg" alt="E-Compvenience" class="footer__logo" width="108" height="36" />
      </a>
      <p class="footer__tagline">Spatial technology & digital twins</p>
      <div class="footer__socials">
        {socials.map((item) => (
          <a href={item.href} target="_blank" rel="noopener noreferrer" class="footer__social-link" aria-label={item.label}>
            {item.svgPath ? (
              <svg class="footer__social-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden>
                <path d={item.svgPath} />
              </svg>
            ) : (
              <item.icon size={20} strokeWidth={2} aria-hidden />
            )}
          </a>
        ))}
      </div>
    </div>
    <nav class="footer__nav" aria-label="Footer navigation">
      <a href="#about" class="footer__link">About</a>
      <a href="#services" class="footer__link">Services</a>
      <a href="#digital-twins" class="footer__link">Digital Twins</a>
      <a href="#interactive-model" class="footer__link">Interactive Model</a>
      <a href="#use-cases" class="footer__link">Use Cases</a>
      <a href="#contact" class="footer__link">Contact</a>
    </nav>
    <p class="footer__copy">© {new Date().getFullYear()} E-Compvenience. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    padding: var(--s-12) var(--s-8);
    background: var(--c-surface);
    border-top: 1px solid var(--c-border);
  }

  .footer__inner {
    max-width: 66rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-8);
    text-align: center;
  }

  @media (min-width: 769px) {
    .footer__inner {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-start;
      text-align: left;
    }
  }

  .footer__brand {
    flex-shrink: 0;
  }

  .footer__logo-link {
    display: block;
  }

  .footer__logo {
    display: block;
    height: 2rem;
    width: auto;
  }

  .footer__tagline {
    margin: var(--s-2) 0 0;
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }

  .footer__socials {
    display: flex;
    gap: var(--s-4);
    margin-top: var(--s-4);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-text-muted);
    transition: color 0.2s;
  }

  .footer__social-link:hover {
    color: var(--accent-primary);
  }

  .footer__social-icon {
    display: block;
    flex-shrink: 0;
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    justify-content: center;
  }

  @media (min-width: 769px) {
    .footer__nav {
      justify-content: flex-start;
    }
  }

  .footer__link {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer__link:hover {
    color: var(--accent-primary);
  }

  .footer__copy {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    width: 100%;
  }

  @media (min-width: 769px) {
    .footer__copy {
      width: auto;
      order: 3;
      flex-basis: 100%;
      margin-top: var(--s-2);
    }
  }
</style>
