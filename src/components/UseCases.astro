---
const useCases = [
  {
    title: 'Real Estate',
    description: 'AR/VR property tours, development visualisation, and stakeholder presentations that bring spaces to life before they exist.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9v.01"/><path d="M9 12v.01"/><path d="M9 15v.01"/><path d="M9 18v.01"/></svg>`,
    accent: '#d9ff00',
    items: [
      'Virtual Property Walkthroughs',
      'Off-Plan 3D Visualisation',
      'Stakeholder Presentation Suites',
      'Interactive Floor Plan Mapping',
      'Construction Progress Monitoring',
    ],
  },
  {
    title: 'Smart City',
    description: 'Digital twins for urban planning, traffic simulation, and city-scale monitoring powering the cities of tomorrow.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="6" height="15" rx="1"/><rect x="9" y="2" width="6" height="19" rx="1"/><rect x="17" y="9" width="6" height="12" rx="1"/><path d="M4 9v.01"/><path d="M4 12v.01"/><path d="M4 15v.01"/><path d="M12 5v.01"/><path d="M12 8v.01"/><path d="M12 11v.01"/><path d="M20 12v.01"/><path d="M20 15v.01"/></svg>`,
    accent: '#00d4ff',
    items: [
      'Urban Planning Simulations',
      'Real-Time Traffic Monitoring',
      'Utility Network Mapping',
      'Environmental Impact Analysis',
      'Emergency Response Planning',
    ],
  },
  {
    title: 'Smart Campus',
    description: 'Campus-wide digital twins for universities, corporate parks, and institutional environments.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3L1 9l11 6 9-4.91V17"/><path d="M5 13.18v4L12 21l7-3.82v-4"/></svg>`,
    accent: '#a78bfa',
    items: [
      'Wayfinding & Navigation',
      'Space Utilisation Analytics',
      'Event & Facility Management',
      'Sustainability Monitoring',
      'Security & Access Control',
    ],
  },
  {
    title: 'Smart Building',
    description: 'Intelligent building management, real-time occupancy analytics, and energy optimisation through connected digital twins.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg>`,
    accent: '#fb923c',
    items: [
      'Real-Time Occupancy Tracking',
      'HVAC & Energy Optimisation',
      'Predictive Maintenance Alerts',
      'Space Planning & Allocation',
      'Visitor & Access Management',
    ],
  },
  {
    title: 'Smart Infrastructure',
    description: 'Asset management, predictive maintenance, and IoT-augmented infrastructure twins for roads, bridges, and utilities.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"/><path d="M5 20V8l4-4 4 4v12"/><path d="M9 4v0"/><path d="M3 20l6-12 6 12"/><path d="M15 20l3-6 3 6"/><circle cx="18" cy="9" r="3"/></svg>`,
    accent: '#34d399',
    items: [
      'Bridge & Road Condition Monitoring',
      'Predictive Maintenance Scheduling',
      'IoT Sensor Integration',
      'Asset Lifecycle Management',
      'Utility Network Visualisation',
    ],
  },
];
---

<section id="use-cases" class="use-cases">
  <div class="use-cases__inner">
    <h2 class="use-cases__title">Use Cases</h2>
    <p class="use-cases__subtitle">
      Discover how digital twins and spatial technology transform industries.
    </p>

    <div class="bento">
      {useCases.map((uc, i) => (
        <article class={`bento__card bento__card--${i + 1}`} style={`--card-accent: ${uc.accent};`}>
          <div class="bento__body">
            <div class="bento__content">
              <div class="bento__icon" set:html={uc.icon} />
              <h3 class="bento__title">{uc.title}</h3>
              <p class="bento__desc">{uc.description}</p>
            </div>
            <ul class="bento__list">
              {uc.items.map((item) => (
                <li class="bento__list-item">{item}</li>
              ))}
            </ul>
          </div>
          <button class="bento__toggle" aria-label="Show details" type="button">
            <span class="bento__toggle-icon" />
          </button>
          <div class="bento__glow" />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .use-cases {
    min-height: 100vh;
    padding: var(--s-8) var(--s-6);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 480px) {
    .use-cases {
      padding: var(--s-6) var(--s-5);
    }
  }

  .use-cases__inner {
    max-width: 72rem;
    width: 100%;
  }

  .use-cases__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0 0 var(--s-4);
    color: var(--c-text);
    text-align: left;
    text-transform: uppercase;
  }

  @media (min-width: 769px) {
    .use-cases__title {
      font-size: clamp(3rem, 6vw, 4.5rem);
      letter-spacing: -0.02em;
      margin-bottom: var(--s-4);
    }
  }

  .use-cases__subtitle {
    margin: 0 0 var(--s-10);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--c-text-muted);
    text-align: left;
    max-width: 42ch;
  }

  @media (min-width: 769px) {
    .use-cases__subtitle {
      font-size: var(--text-2xl);
      line-height: 1.75;
      color: var(--c-text-sub);
      margin-bottom: var(--s-12);
      max-width: 60ch;
    }
  }

  /* ── Bento Grid ────────────────────────────────────────────── */

  .bento {
    display: grid;
    gap: clamp(0.75rem, 1.5vw, 1rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .bento {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: auto auto;
    }

    .bento__card--1 { grid-column: 1 / 3; grid-row: 1 / 2; }
    .bento__card--2 { grid-column: 3 / 5; grid-row: 1 / 2; }
    .bento__card--3 { grid-column: 1 / 2; grid-row: 2 / 3; }
    .bento__card--4 { grid-column: 2 / 4; grid-row: 2 / 3; }
    .bento__card--5 { grid-column: 4 / 5; grid-row: 2 / 3; }
  }

  /* ── Card ──────────────────────────────────────────────────── */

  .bento__card {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    transition: border-color 0.35s ease, transform 0.35s ease;
    will-change: transform;
  }

  .bento__card:hover {
    border-color: color-mix(in srgb, var(--card-accent) 35%, transparent);
  }

  .bento__glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: radial-gradient(
      ellipse at 30% 0%,
      color-mix(in srgb, var(--card-accent) 8%, transparent),
      transparent 70%
    );
    transition: opacity 0.45s ease;
    pointer-events: none;
  }

  .bento__card:hover .bento__glow {
    opacity: 1;
  }

  .bento__body {
    display: grid;
  }

  .bento__body > * {
    grid-area: 1 / 1;
  }

  .bento__content {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
  }

  .bento__card.is-expanded .bento__content {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    pointer-events: none;
  }

  .bento__icon {
    color: var(--card-accent);
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    margin-bottom: var(--s-1);
  }

  .bento__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    margin: 0;
    color: var(--c-text);
    letter-spacing: -0.01em;
  }

  .bento__desc {
    margin: 0;
    font-size: var(--text-base);
    color: var(--c-text-muted);
    line-height: 1.6;
  }

  /* ── Expandable List ────────────────────────────────────────── */

  .bento__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
  }

  .bento__card.is-expanded .bento__list {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
    transition-delay: 0.08s;
  }

  .bento__list-item {
    font-size: var(--text-base);
    color: var(--c-text-muted);
    line-height: 1.4;
    padding-left: 1.125rem;
    position: relative;
  }

  .bento__list-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--card-accent);
    opacity: 0.7;
  }

  /* ── Toggle Button ──────────────────────────────────────────── */

  .bento__toggle {
    position: absolute;
    bottom: clamp(0.75rem, 2vw, 1.25rem);
    right: clamp(0.75rem, 2vw, 1.25rem);
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.05);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
    padding: 0;
  }

  .bento__toggle:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: color-mix(in srgb, var(--card-accent) 50%, transparent);
    transform: scale(1.08);
  }

  .bento__toggle-icon {
    position: relative;
    width: 12px;
    height: 12px;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .bento__toggle-icon::before,
  .bento__toggle-icon::after {
    content: '';
    position: absolute;
    background: var(--card-accent);
    border-radius: 1px;
  }

  .bento__toggle-icon::before {
    width: 12px;
    height: 1.5px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }

  .bento__toggle-icon::after {
    width: 1.5px;
    height: 12px;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
  }

  .bento__card.is-expanded .bento__toggle-icon {
    transform: rotate(45deg);
  }

  /* Featured cards get larger titles on desktop */
  @media (min-width: 960px) {
    .bento__card--1 .bento__title,
    .bento__card--2 .bento__title {
      font-size: var(--text-2xl);
    }

    .bento__card--1 .bento__desc,
    .bento__card--2 .bento__desc {
      font-size: var(--text-lg);
    }

    .bento__card--4 .bento__title {
      font-size: var(--text-2xl);
    }
  }
</style>

<script>
  document.querySelectorAll('.bento__toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.bento__card');
      if (!card) return;
      const expanding = !card.classList.contains('is-expanded');
      card.classList.toggle('is-expanded');
      btn.setAttribute('aria-label', expanding ? 'Hide details' : 'Show details');
    });
  });
</script>
