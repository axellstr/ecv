---
---

<section id="interactive-model" class="interactive-model">
  <div class="interactive-model__inner">
    <h2 class="interactive-model__title">Interactive Model</h2>
    <p class="interactive-model__description">
      Explore our 3D models directly in your browser. Rotate, zoom, and inspect every detail—
      from geospatial environments to architectural assets.
    </p>

    <!-- Model tabs (outside viewport) -->
    <div class="interactive-model__tabs" role="tablist" aria-label="Select building model">
      <button class="interactive-model__tab is-active" role="tab" aria-selected="true" data-model="leventis" id="tabLeventis">
        University House Leventis
      </button>
      <button class="interactive-model__tab" role="tab" aria-selected="false" data-model="ctf01" id="tabCtf01">
        Common Teaching Facilities 1 (CTF01)
      </button>
      <button class="interactive-model__tab" role="tab" aria-selected="false" data-model="socialsquare" id="tabSocialsquare">
        Social Square
      </button>
    </div>

    <div class="interactive-model__viewport-wrap">
      <div class="interactive-model__viewport" id="modelViewport">
        <canvas id="modelCanvas"></canvas>
        <div class="interactive-model__loader" id="modelLoader">
          <div class="interactive-model__spinner"></div>
          <span class="interactive-model__loader-text" id="modelLoaderText">Loading model…</span>
        </div>
        <div class="interactive-model__solar-tooltip" id="solarTooltip">
          <span class="solar-tooltip__title">Solar Energy System</span>
          <span class="solar-tooltip__desc">Click to explore the photovoltaic array</span>
        </div>

        <div class="interactive-model__solar-hotspot" id="solarHotspot">
          <div class="solar-hotspot__dot"></div>
          <div class="solar-hotspot__ring"></div>
        </div>

        <div class="interactive-model__solar-dash" id="solarDash">
          <div class="solar-dash__header">
            <div class="solar-dash__live">
              <span class="solar-dash__live-dot"></span>
              <span class="solar-dash__live-label">LIVE</span>
            </div>
            <span class="solar-dash__title">Solar Energy System</span>
            <button class="solar-dash__close" id="solarDashClose" aria-label="Close">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>
          <div class="solar-dash__grid">
            <div class="solar-dash__stat">
              <div class="solar-dash__stat-row">
                <span class="solar-dash__stat-value" id="solarOutput">0.0</span>
                <span class="solar-dash__stat-unit">kW</span>
              </div>
              <span class="solar-dash__stat-label">Current Output</span>
            </div>
            <div class="solar-dash__stat">
              <div class="solar-dash__stat-row">
                <span class="solar-dash__stat-value" id="solarPerM2">0.0</span>
                <span class="solar-dash__stat-unit">W/m²</span>
              </div>
              <span class="solar-dash__stat-label">Power per m²</span>
            </div>
            <div class="solar-dash__stat solar-dash__stat--wide">
              <div class="solar-dash__stat-row">
                <span class="solar-dash__stat-value" id="solarTotal">0.0</span>
                <span class="solar-dash__stat-unit">kWh</span>
              </div>
              <span class="solar-dash__stat-label">Total Energy Generated</span>
            </div>
            <div class="solar-dash__stat">
              <div class="solar-dash__stat-row">
                <span class="solar-dash__stat-value" id="solarEff">0.0</span>
                <span class="solar-dash__stat-unit">%</span>
              </div>
              <span class="solar-dash__stat-label">Panel Efficiency</span>
            </div>
          </div>
          <div class="solar-dash__footer" id="solarDashFooter">
            <span id="solarFooterPanels">48 Panels</span>
            <span class="solar-dash__footer-sep">·</span>
            <span id="solarFooterKwp">14.4 kWp</span>
            <span class="solar-dash__footer-sep">·</span>
            <span id="solarFooterArea">96 m²</span>
          </div>
        </div>

        <div class="interactive-model__controls">
          <span>Drag to rotate</span>
          <span>Scroll to zoom</span>
          <span>Right-drag to pan</span>
        </div>

        <!-- Info toggle stays inside viewport -->
        <button class="interactive-model__info-toggle" id="infoToggle" aria-label="Toggle model info">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="16" x2="12" y2="12"/>
            <line x1="12" y1="8" x2="12.01" y2="8"/>
          </svg>
        </button>
      </div>

      <!-- Info panel lives outside viewport for mobile flow -->
      <div class="interactive-model__info-panel" id="infoPanel">
        <div class="info-panel__header">
          <h3 class="info-panel__title" id="infoPanelTitle">University House Anastasios G. Leventis</h3>
          <p class="info-panel__location" id="infoPanelLocation">Nicosia, Cyprus</p>
          <p class="info-panel__desc" id="infoPanelDesc">Digital Twin Reconstruction: Photogrammetry and BIM documentation</p>
        </div>

        <div class="info-panel__section" id="infoPanelStatsSection">
          <span class="info-panel__label">Statistics</span>
          <div class="info-panel__stats" id="infoPanelStats">
            <div class="info-panel__stat">
              <span class="info-panel__stat-value">9527.2</span>
              <span class="info-panel__stat-key">m² Indoor</span>
            </div>
            <div class="info-panel__stat">
              <span class="info-panel__stat-value">282</span>
              <span class="info-panel__stat-key">Spaces & Offices</span>
            </div>
            <div class="info-panel__stat">
              <span class="info-panel__stat-value">1200+</span>
              <span class="info-panel__stat-key">m² Outdoor Area</span>
            </div>
            <div class="info-panel__stat">
              <span class="info-panel__stat-value">3</span>
              <span class="info-panel__stat-key">Staircases</span>
            </div>
          </div>
        </div>

        <div class="info-panel__section">
          <span class="info-panel__label">Controls</span>
          <div class="info-panel__actions">
            <button class="info-panel__btn" id="btnWireframe">Wireframe</button>
            <button class="info-panel__btn" id="btnReset">Reset View</button>
          </div>
        </div>

        <div class="info-panel__section">
          <span class="info-panel__label">Viewpoints</span>
          <div class="info-panel__actions">
            <button class="info-panel__btn" id="btnViewIso">Isometric</button>
            <button class="info-panel__btn" id="btnViewFront">Front</button>
            <button class="info-panel__btn" id="btnViewTop">Top</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .interactive-model {
    padding: var(--s-16) var(--s-8);
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(ellipse 70% 50% at 50% 40%, var(--spotlight-accent), transparent),
      var(--c-surface);
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
  }

  @media (max-width: 480px) {
    .interactive-model {
      padding: var(--s-12) var(--s-5);
    }
  }

  @media (min-width: 769px) {
    .interactive-model {
      padding: var(--s-24) var(--s-8);
    }
  }

  .interactive-model__inner {
    max-width: 42rem;
    text-align: left;
    width: 100%;
  }

  @media (min-width: 769px) {
    .interactive-model__inner {
      max-width: 66rem;
    }
  }

  .interactive-model__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    font-weight: 400;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 var(--s-6);
    color: var(--c-text);
  }

  @media (min-width: 769px) {
    .interactive-model__title {
      font-size: clamp(3rem, 6vw, 4.5rem);
      letter-spacing: -0.02em;
      margin-bottom: var(--s-10);
    }
  }

  .interactive-model__description {
    margin: 0 0 var(--s-10);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.6;
    color: var(--c-text-muted);
  }

  @media (min-width: 769px) {
    .interactive-model__description {
      font-size: var(--text-2xl);
      line-height: 1.55;
      color: var(--c-text-sub);
      margin-bottom: var(--s-12);
      max-width: 44rem;
    }
  }

  /* ── Model Tabs ──────────────────────────────────────────────────────── */

  .interactive-model__tabs {
    display: flex;
    gap: var(--s-2);
    margin-top: var(--s-6);
    margin-bottom: var(--s-4);
    flex-wrap: wrap;
  }

  @media (min-width: 769px) {
    .interactive-model__tabs {
      margin-top: var(--s-8);
      margin-bottom: var(--s-5);
    }
  }

  .interactive-model__tab {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--c-border);
    border-radius: 100px;
    padding: var(--s-2) var(--s-4);
    cursor: pointer;
    transition:
      background var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      transform var(--duration-fast) ease;
  }

  .interactive-model__tab:hover {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.85);
    border-color: var(--c-border-hover);
  }

  .interactive-model__tab:active {
    transform: scale(0.97);
  }

  .interactive-model__tab.is-active {
    background: var(--accent-glow);
    color: var(--accent-primary);
    border-color: rgba(217, 255, 0, 0.35);
  }

  /* ── 3D Viewport ────────────────────────────────────────────────────── */

  .interactive-model__viewport-wrap {
    position: relative;
    margin-top: var(--s-6);
  }

  .interactive-model__viewport {
    position: relative;
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid var(--c-border);
    background: #0a0a0a;
    aspect-ratio: 16 / 9;
  }

  @media (max-width: 768px) {
    .interactive-model__viewport {
      aspect-ratio: 4 / 3;
    }
  }

  #modelCanvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  /* Loading overlay */
  .interactive-model__loader {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-4);
    background: #0a0a0a;
    z-index: 2;
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }

  .interactive-model__loader.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .interactive-model__spinner {
    width: 36px;
    height: 36px;
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    animation: model-spin 0.8s linear infinite;
  }

  @keyframes model-spin {
    to { transform: rotate(360deg); }
  }

  .interactive-model__loader-text {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    letter-spacing: 0.04em;
  }

  /* Hint bar */
  .interactive-model__controls {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: var(--s-6);
    padding: var(--s-3) var(--s-4);
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    z-index: 1;
    pointer-events: none;
  }

  .interactive-model__controls span {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .interactive-model__controls {
      gap: var(--s-3);
    }
    .interactive-model__controls span {
      font-size: 0.625rem;
    }
  }

  /* ── Solar Tooltip ────────────────────────────────────────────────────── */

  .interactive-model__solar-tooltip {
    position: absolute;
    z-index: 4;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 14px));
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px 14px;
    background: rgba(10, 10, 10, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--r-md);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.22s ease, visibility 0.22s ease;
  }

  .interactive-model__solar-tooltip.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .solar-tooltip__title {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    color: #d9ff00;
    letter-spacing: 0.03em;
  }

  .solar-tooltip__desc {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.01em;
    line-height: 1.35;
  }

  @media (max-width: 768px) {
    .interactive-model__solar-tooltip {
      display: none;
    }
  }

  /* ── Solar Hotspot (mobile) ──────────────────────────────────────────── */

  .interactive-model__solar-hotspot {
    display: none;
  }

  @media (max-width: 768px) {
    .interactive-model__solar-hotspot {
      display: block;
      position: absolute;
      z-index: 4;
      pointer-events: none;
      left: 0;
      top: 0;
      will-change: transform;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.35s ease, visibility 0.35s ease;
    }

    .interactive-model__solar-hotspot.is-visible {
      opacity: 1;
      visibility: visible;
    }

    .solar-hotspot__dot {
      width: 10px;
      height: 10px;
      background: #d9ff00;
      border-radius: 50%;
      box-shadow: 0 0 6px rgba(217, 255, 0, 0.4);
    }

    .solar-hotspot__ring {
      position: absolute;
      inset: -6px;
      border: 1.5px solid rgba(217, 255, 0, 0.45);
      border-radius: 50%;
      animation: solar-hotspot-pulse 2.2s ease-in-out infinite;
    }

    @keyframes solar-hotspot-pulse {
      0%, 100% { transform: scale(1); opacity: 0.6; }
      50% { transform: scale(2.2); opacity: 0; }
    }
  }

  /* ── Solar Dashboard ────────────────────────────────────────────────── */

  .interactive-model__solar-dash {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    z-index: 5;
    width: 280px;
    background: rgba(10, 10, 10, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--r-lg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: var(--s-4);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-12px);
    transition: opacity 0.35s ease, visibility 0.35s ease, transform 0.35s ease;
    pointer-events: none;
  }

  .interactive-model__solar-dash.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    pointer-events: auto;
  }

  .solar-dash__header {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-3);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .solar-dash__live {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px 2px 6px;
    background: rgba(34, 197, 94, 0.12);
    border: 1px solid rgba(34, 197, 94, 0.25);
    border-radius: 100px;
    flex-shrink: 0;
  }

  .solar-dash__live-dot {
    width: 6px;
    height: 6px;
    background: #22c55e;
    border-radius: 50%;
    animation: solar-live-pulse 1.5s ease-in-out infinite;
  }

  @keyframes solar-live-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .solar-dash__live-label {
    font-family: var(--font-heading);
    font-size: 0.5625rem;
    font-weight: 600;
    color: #22c55e;
    letter-spacing: 0.06em;
  }

  .solar-dash__title {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 500;
    color: #fff;
    flex: 1;
    letter-spacing: 0.01em;
  }

  .solar-dash__close {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    flex-shrink: 0;
  }

  .solar-dash__close:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .solar-dash__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-3);
    margin-bottom: var(--s-3);
  }

  .solar-dash__stat--wide {
    grid-column: 1 / -1;
  }

  .solar-dash__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .solar-dash__stat-row {
    display: flex;
    align-items: baseline;
    gap: 3px;
  }

  .solar-dash__stat-value {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .solar-dash__stat--wide .solar-dash__stat-value {
    font-size: var(--text-xl);
    color: #d9ff00;
  }

  .solar-dash__stat-unit {
    font-family: var(--font-heading);
    font-size: 0.625rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.02em;
  }

  .solar-dash__stat-label {
    font-family: var(--font-heading);
    font-size: 0.625rem;
    color: rgba(255, 255, 255, 0.35);
    letter-spacing: 0.02em;
  }

  .solar-dash__footer {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding-top: var(--s-3);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-family: var(--font-heading);
    font-size: 0.625rem;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.02em;
  }

  .solar-dash__footer-sep {
    color: rgba(255, 255, 255, 0.15);
  }

  @media (max-width: 768px) {
    .interactive-model__solar-dash {
      width: auto;
      max-width: calc(100% - var(--s-2) * 2);
      top: var(--s-2);
      left: var(--s-2);
      bottom: auto;
      transform: translateY(-6px);
      padding: 8px 10px;
      border-radius: var(--r-md);
    }

    .interactive-model__solar-dash.is-visible {
      transform: translateY(0);
    }

    .solar-dash__header {
      margin-bottom: 6px;
      padding-bottom: 6px;
      gap: 6px;
    }

    .solar-dash__title {
      font-size: 0.6875rem;
    }

    .solar-dash__close {
      width: 24px;
      height: 24px;
    }

    .solar-dash__close svg {
      width: 12px;
      height: 12px;
    }

    .solar-dash__grid {
      gap: 6px;
      margin-bottom: 0;
    }

    .solar-dash__stat--wide {
      grid-column: auto;
    }

    .solar-dash__stat-row {
      gap: 2px;
    }

    .solar-dash__stat-value {
      font-size: 0.8125rem;
    }

    .solar-dash__stat--wide .solar-dash__stat-value {
      font-size: 0.875rem;
      color: #d9ff00;
    }

    .solar-dash__stat-unit {
      font-size: 0.5625rem;
    }

    .solar-dash__stat-label {
      font-size: 0.5625rem;
    }

    .solar-dash__footer {
      display: none;
    }
  }

  /* ── Info Toggle Button ───────────────────────────────────────────────── */

  .interactive-model__info-toggle {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
    z-index: 3;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(10, 10, 10, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .interactive-model__info-toggle:hover {
    background: rgba(10, 10, 10, 0.85);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .interactive-model__info-toggle.is-active {
    background: rgba(217, 255, 0, 0.12);
    border-color: rgba(217, 255, 0, 0.4);
    color: #d9ff00;
  }

  /* ── Info Panel ───────────────────────────────────────────────────────── */

  .interactive-model__info-panel {
    position: absolute;
    top: calc(var(--s-3) + 36px + var(--s-2));
    right: var(--s-3);
    z-index: 3;
    width: 340px;
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: var(--s-5);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity var(--duration-normal) var(--ease-out),
      visibility var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
    pointer-events: none;
  }

  .interactive-model__info-panel.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Panel header */
  .info-panel__header {
    margin-bottom: var(--s-4);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .info-panel__title {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 500;
    color: #fff;
    margin: 0 0 2px;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  .info-panel__location {
    font-size: 0.6875rem;
    color: rgba(255, 255, 255, 0.5);
    margin: 0 0 4px;
    letter-spacing: 0.02em;
  }

  .info-panel__desc {
    font-size: 0.6875rem;
    color: rgba(255, 255, 255, 0.35);
    margin: 0;
    line-height: 1.4;
  }

  /* Sections */
  .info-panel__section {
    margin-bottom: var(--s-3);
  }

  .info-panel__section:last-child {
    margin-bottom: 0;
  }

  .info-panel__label {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.625rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--s-2);
  }

  /* Stats grid — children are dynamically created via JS innerHTML,
     so they need :global() to bypass Astro scoping. */
  .info-panel__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .info-panel__stats :global(.info-panel__stat) {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding: 10px 12px;
    background: var(--c-surface-elevated);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    transition:
      background var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  .info-panel__stats :global(.info-panel__stat:hover) {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--c-border-hover);
  }

  .info-panel__stats :global(.info-panel__stat-value) {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .info-panel__stats :global(.info-panel__stat-key) {
    font-family: var(--font-heading);
    font-size: 0.625rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.38);
    letter-spacing: 0.02em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  /* Control buttons */
  .info-panel__actions {
    display: flex;
    gap: var(--s-2);
    flex-wrap: wrap;
  }

  .info-panel__btn {
    font-family: var(--font-heading);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--c-border);
    border-radius: 100px;
    padding: 5px 12px;
    cursor: pointer;
    transition:
      background var(--duration-normal) var(--ease-out),
      color var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      transform var(--duration-fast) ease;
    white-space: nowrap;
  }

  .info-panel__btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border-color: var(--c-border-hover);
  }

  .info-panel__btn:active {
    transform: scale(0.96);
  }

  .info-panel__btn.is-active {
    background: var(--accent-glow);
    color: var(--accent-primary);
    border-color: rgba(217, 255, 0, 0.3);
  }

  /* ── Info Panel Mobile ────────────────────────────────────────────────── */

  @media (max-width: 768px) {
    .interactive-model__info-panel {
      position: static;
      width: 100%;
      top: auto;
      right: auto;
      margin-top: var(--s-3);
      border-radius: var(--r-xl);
      transform: none;
      max-height: 0;
      overflow: hidden;
      padding: 0 var(--s-5);
      border-color: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: rgba(10, 10, 10, 0.95);
      transition:
        max-height 0.35s var(--ease-out),
        opacity var(--duration-normal) var(--ease-out),
        padding 0.35s var(--ease-out),
        border-color var(--duration-normal) var(--ease-out);
    }

    .interactive-model__info-panel.is-visible {
      max-height: 600px;
      padding: var(--s-5);
      border-color: var(--c-border);
      transform: none;
    }

    .interactive-model__info-toggle {
      top: var(--s-2);
      right: var(--s-2);
      width: 32px;
      height: 32px;
    }

    .interactive-model__info-toggle svg {
      width: 15px;
      height: 15px;
    }
  }
</style>

<script>
  const viewport = document.getElementById('modelViewport') as HTMLDivElement;
  const canvas = document.getElementById('modelCanvas') as HTMLCanvasElement;
  const loader = document.getElementById('modelLoader') as HTMLDivElement;
  const loaderText = document.getElementById('modelLoaderText') as HTMLSpanElement;

  const infoToggle = document.getElementById('infoToggle') as HTMLButtonElement;
  const infoPanel = document.getElementById('infoPanel') as HTMLDivElement;

  const MODEL_CONFIG: Record<string, {
    path: string;
    title: string;
    location: string;
    desc: string;
    stats: { value: string; key: string }[];
    hasSolar: boolean;
    solarConfig?: {
      panels: number;
      kWp: number;
      areaM2: number;
      nominalOutputKW: number;
      nominalPerM2: number;
      totalKWh: number;
      efficiency: number;
    };
  }> = {
    leventis: {
      path: '/models/leventis.glb',
      title: 'University House Anastasios G. Leventis',
      location: 'Nicosia, Cyprus',
      desc: 'Digital Twin Reconstruction: Photogrammetry and BIM documentation',
      stats: [
        { value: '9527.2', key: 'm² Indoor' },
        { value: '282', key: 'Spaces & Offices' },
        { value: '1200+', key: 'm² Outdoor Area' },
        { value: '3', key: 'Staircases' },
      ],
      hasSolar: true,
      solarConfig: {
        panels: 48,
        kWp: 14.4,
        areaM2: 96,
        nominalOutputKW: 12.4,
        nominalPerM2: 129.2,
        totalKWh: 147283.7,
        efficiency: 94.2,
      },
    },
    ctf01: {
      path: '/models/XOD01.glb',
      title: 'Common Teaching Facilities 1 (CTF01)',
      location: 'University of Cyprus, Nicosia, Cyprus',
      desc: 'Digital Twin Reconstruction: Photogrammetry and BIM documentation',
      stats: [
        { value: '750+', key: 'm² Indoor Area' },
        { value: '800+', key: 'm² Outdoor Area' },
        { value: '3', key: 'Staircases' },
        { value: '37', key: 'Classrooms' },
      ],
      hasSolar: false,
    },
    socialsquare: {
      path: '/models/socialsquare.glb',
      title: 'Social Square',
      location: 'University of Cyprus, Nicosia, Cyprus',
      desc: 'Digital Twin Reconstruction: Photogrammetry and BIM documentation',
      stats: [
        { value: '11,500+', key: 'm² Indoor Area' },
        { value: '9,000+', key: 'm² Outdoor Area' },
        { value: '19', key: 'Staircases' },
        { value: '259', key: 'Spaces & Premises' },
      ],
      hasSolar: true,
      solarConfig: {
        panels: 96,
        kWp: 28.8,
        areaM2: 192,
        nominalOutputKW: 24.8,
        nominalPerM2: 129.2,
        totalKWh: 294567.2,
        efficiency: 93.8,
      },
    },
  };

  if (infoToggle && infoPanel) {
    infoToggle.addEventListener('click', () => {
      const open = infoPanel.classList.toggle('is-visible');
      infoToggle.classList.toggle('is-active', open);
    });
  }

  if (viewport && canvas) {
    const observer = new IntersectionObserver(
    async (entries) => {
      const [entry] = entries;
      if (!entry?.isIntersecting) return;
      observer.disconnect();

      const THREE = await import('three');
      const { OrbitControls } = await import('three/addons/controls/OrbitControls.js');
      const { GLTFLoader } = await import('three/addons/loaders/GLTFLoader.js');
      const { DRACOLoader } = await import('three/addons/loaders/DRACOLoader.js');

      const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: matchMedia('(min-width: 769px)').matches,
      alpha: false,
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.0;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0a0a0a);

    const camera = new THREE.PerspectiveCamera(45, canvas.clientWidth / canvas.clientHeight, 0.1, 2000);

    const ambient = new THREE.AmbientLight(0xffffff, 0.5);
    scene.add(ambient);

    const dirLight = new THREE.DirectionalLight(0xffffff, 1.5);
    dirLight.position.set(50, 80, 60);
    dirLight.castShadow = false;
    scene.add(dirLight);

    const fillLight = new THREE.DirectionalLight(0xaaccff, 0.4);
    fillLight.position.set(-40, 20, -30);
    scene.add(fillLight);

    const hemiLight = new THREE.HemisphereLight(0xddeeff, 0x222211, 0.6);
    scene.add(hemiLight);

    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.dampingFactor = 0.06;
    controls.minDistance = 5;
    controls.maxDistance = 500;
    controls.maxPolarAngle = Math.PI / 2;
    controls.enablePan = true;
    controls.panSpeed = 0.8;
    controls.rotateSpeed = 0.6;
    controls.zoomSpeed = 1.0;

    let cachedVW = viewport.clientWidth;
    let cachedVH = viewport.clientHeight;

    function resize() {
      const w = viewport.clientWidth;
      const h = viewport.clientHeight;
      cachedVW = w;
      cachedVH = h;
      renderer.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();

    let resetAnim: {
      start: number;
      duration: number;
      fromPos: any;
      fromTarget: any;
      toPos: any;
      toTarget: any;
    } | null = null;
    let initialCamPos: any = null;
    let initialTarget: any = null;
    let lastCullUpdate = 0;
    const smallMeshDistanceCulling: { mesh: any; center: any; hideDistanceSq: number }[] = [];
    const updateDistanceCulling = () => {
      const camPos = camera.position;
      for (const item of smallMeshDistanceCulling) {
        const isFar = camPos.distanceToSquared(item.center) > item.hideDistanceSq;
        item.mesh.visible = !isFar;
      }
    };

    let onPointerMove: ((e: PointerEvent) => void) | null = null;
    let hideTooltip: (() => void) | null = null;
    let updateHotspotPosition: (() => void) | null = null;
    let currentModelId = 'leventis';
    let currentModel: InstanceType<typeof THREE.Object3D> | null = null;
    let currentGrid: InstanceType<typeof THREE.GridHelper> | null = null;
    let currentAllMeshes: InstanceType<typeof THREE.Mesh>[] = [];
    let deactivateSolar: (() => void) | null = null;
    let removeSolarListeners: (() => void) | null = null;
    const controlHandlers: { remove: () => void }[] = [];

    function updateInfoPanel(modelId: string) {
      const config = MODEL_CONFIG[modelId];
      if (!config) return;
      const titleEl = document.getElementById('infoPanelTitle');
      const locationEl = document.getElementById('infoPanelLocation');
      const descEl = document.getElementById('infoPanelDesc');
      const statsEl = document.getElementById('infoPanelStats');
      if (titleEl) titleEl.textContent = config.title;
      if (locationEl) locationEl.textContent = config.location;
      if (descEl) descEl.textContent = config.desc;
      if (statsEl) {
        statsEl.innerHTML = config.stats.map(
          (s) => `<div class="info-panel__stat"><span class="info-panel__stat-value">${s.value}</span><span class="info-panel__stat-key">${s.key}</span></div>`
        ).join('');
      }
    }

    function setActiveTab(modelId: string) {
      document.querySelectorAll('.interactive-model__tab').forEach((tab) => {
        const btn = tab as HTMLButtonElement;
        const isActive = btn.dataset.model === modelId;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-selected', String(isActive));
      });
    }

    const dracoLoader = new DRACOLoader();
    dracoLoader.setDecoderPath('https://www.gstatic.com/draco/versioned/decoders/1.5.7/');
    const gltfLoader = new GLTFLoader();
    gltfLoader.setDRACOLoader(dracoLoader);

    function loadModel(modelId: string) {
      const config = MODEL_CONFIG[modelId];
      if (!config) return;

      if (deactivateSolar) {
        deactivateSolar();
        deactivateSolar = null;
      }
      if (removeSolarListeners) {
        removeSolarListeners();
        removeSolarListeners = null;
      }
      updateHotspotPosition = null;

      controlHandlers.forEach((h) => h.remove());
      controlHandlers.length = 0;

      document.getElementById('btnWireframe')?.classList.remove('is-active');

      if (currentModel) {
        scene.remove(currentModel);
        currentModel.traverse((obj: any) => {
          if (obj.isMesh) {
            obj.geometry?.dispose();
            const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
            mats.forEach((m: any) => m?.dispose?.());
          }
        });
        currentModel = null;
      }
      if (currentGrid) {
        scene.remove(currentGrid);
        (currentGrid.material as InstanceType<typeof THREE.Material>)?.dispose?.();
        currentGrid = null;
      }

      currentAllMeshes = [];
      smallMeshDistanceCulling.length = 0;
      currentModelId = modelId;
      updateInfoPanel(modelId);
      setActiveTab(modelId);

      if (loader) {
        loader.classList.remove('is-hidden');
        loaderText!.textContent = 'Loading model…';
      }

      gltfLoader.load(
      config.path,
      (gltf) => {
        const model = gltf.scene;
        currentModel = model;

        const toRemove: InstanceType<typeof THREE.Object3D>[] = [];
        const allMeshes: InstanceType<typeof THREE.Mesh>[] = [];
        model.traverse((child) => {
          if (
            child instanceof THREE.GridHelper ||
            child instanceof THREE.AxesHelper ||
            (child instanceof THREE.LineSegments && !(child.parent instanceof THREE.Mesh)) ||
            (child instanceof THREE.Line && !(child instanceof THREE.LineSegments) && !(child.parent instanceof THREE.Mesh)) ||
            /grid|axes|helper|gizmo/i.test(child.name)
          ) {
            toRemove.push(child);
          }
          if (child instanceof THREE.Mesh) {
            allMeshes.push(child);
          }
        });
        toRemove.forEach((obj) => obj.parent?.remove(obj));
        currentAllMeshes = allMeshes;

        scene.add(model);

        const box = new THREE.Box3().setFromObject(model);
        const center = box.getCenter(new THREE.Vector3());
        const size = box.getSize(new THREE.Vector3());
        const maxDim = Math.max(size.x, size.y, size.z);

        model.position.sub(center);

        const gridSpan = Math.max(size.x, size.z) * 2.5;
        const gridDivisions = 40;
        const grid = new THREE.GridHelper(
          gridSpan,
          gridDivisions,
          new THREE.Color(0xffffff),
          new THREE.Color(0xffffff)
        );
        grid.position.y = -size.y / 3;
        (grid.material as InstanceType<typeof THREE.Material>).opacity = 0.07;
        (grid.material as InstanceType<typeof THREE.Material>).transparent = true;
        (grid.material as InstanceType<typeof THREE.Material>).depthWrite = false;
        scene.add(grid);
        currentGrid = grid;

        controls.target.set(0, 0, 0);

        const fov = camera.fov * (Math.PI / 180);
        let cameraDistance = (maxDim / 2) / Math.tan(fov / 2);
        cameraDistance *= 0.95;

        camera.position.set(
          cameraDistance * 0.7,
          cameraDistance * 0.45,
          cameraDistance * 0.7
        );
        camera.lookAt(0, 0, 0);

        controls.minDistance = cameraDistance * 0.15;
        controls.maxDistance = cameraDistance * 4;
        controls.update();

        initialCamPos = camera.position.clone();
        initialTarget = controls.target.clone();

        const setCameraAnimation = (
          toPosition: any,
          toTarget: any,
          duration = 850
        ) => {
          resetAnim = {
            start: performance.now(),
            duration,
            fromPos: camera.position.clone(),
            fromTarget: controls.target.clone(),
            toPos: toPosition.clone(),
            toTarget: toTarget.clone(),
          };
        };

        const viewpoints = {
          iso: {
            position: new THREE.Vector3(
              cameraDistance * 0.72,
              cameraDistance * 0.5,
              cameraDistance * 0.72
            ),
            target: new THREE.Vector3(0, 0, 0),
          },
          front: {
            position: new THREE.Vector3(0, cameraDistance * 0.22, cameraDistance * 1.18),
            target: new THREE.Vector3(0, 0, 0),
          },
          top: {
            position: new THREE.Vector3(0, cameraDistance * 1.32, cameraDistance * 0.06),
            target: new THREE.Vector3(0, 0, 0),
          },
        };

        const btnViewIso = document.getElementById('btnViewIso') as HTMLButtonElement | null;
        const btnViewFront = document.getElementById('btnViewFront') as HTMLButtonElement | null;
        const btnViewTop = document.getElementById('btnViewTop') as HTMLButtonElement | null;

        const viewIsoHandler = () => setCameraAnimation(viewpoints.iso.position, viewpoints.iso.target);
        const viewFrontHandler = () => setCameraAnimation(viewpoints.front.position, viewpoints.front.target);
        const viewTopHandler = () => setCameraAnimation(viewpoints.top.position, viewpoints.top.target);
        btnViewIso?.addEventListener('click', viewIsoHandler);
        btnViewFront?.addEventListener('click', viewFrontHandler);
        btnViewTop?.addEventListener('click', viewTopHandler);
        controlHandlers.push({
          remove: () => {
            btnViewIso?.removeEventListener('click', viewIsoHandler);
            btnViewFront?.removeEventListener('click', viewFrontHandler);
            btnViewTop?.removeEventListener('click', viewTopHandler);
          },
        });

        // Hide tiny distant meshes to reduce overdraw and draw-call pressure.
        model.updateMatrixWorld(true);
        smallMeshDistanceCulling.length = 0;
        const tempScale = new THREE.Vector3();
        const tinyMeshRadius = maxDim * 0.01;
        const minimumHideDistance = cameraDistance * 1.75;
        for (const child of allMeshes) {
          if (!child.geometry) continue;
          const geometry = child.geometry;
          if (!geometry.boundingSphere) geometry.computeBoundingSphere();
          const sphere = geometry.boundingSphere;
          if (!sphere) continue;
          child.getWorldScale(tempScale);
          const maxScale = Math.max(tempScale.x, tempScale.y, tempScale.z);
          const worldRadius = sphere.radius * maxScale;
          if (worldRadius > tinyMeshRadius) continue;
          const worldCenter = sphere.center.clone();
          child.localToWorld(worldCenter);
          const hideDistance = Math.max(minimumHideDistance, worldRadius * 120);
          smallMeshDistanceCulling.push({
            mesh: child,
            center: worldCenter,
            hideDistanceSq: hideDistance * hideDistance,
          });
        }
        lastCullUpdate = 0;
        updateDistanceCulling();

        // --- Rooftop solar-panel interactivity (Leventis only) ---
        if (config.hasSolar) {
        const raycaster = new THREE.Raycaster();
        const pointerNDC = new THREE.Vector2();
        const rooftopThresholdY = size.y * 0.35;
        const hasHover = matchMedia('(hover: hover)').matches;

        // Solar dashboard elements
        const solarDash = document.getElementById('solarDash') as HTMLDivElement;
        const solarDashClose = document.getElementById('solarDashClose') as HTMLButtonElement;
        const solarOutputEl = document.getElementById('solarOutput') as HTMLSpanElement;
        const solarPerM2El = document.getElementById('solarPerM2') as HTMLSpanElement;
        const solarTotalEl = document.getElementById('solarTotal') as HTMLSpanElement;
        const solarEffEl = document.getElementById('solarEff') as HTMLSpanElement;

        let solarViewActive = false;
        let preSolarCamPos: any = null;
        let preSolarTarget: any = null;
        let solarTickerId = 0;

        const solarViewpoint = {
          position: new THREE.Vector3(cameraDistance * 0.35, cameraDistance * 0.85, cameraDistance * 0.35),
          target: new THREE.Vector3(0, size.y * 0.2, 0),
        };

        const fmtTotal = (n: number) => {
          const [int, dec] = n.toFixed(1).split('.');
          return int.replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + dec;
        };

        const activateSolarView = () => {
          if (solarViewActive) return;
          solarViewActive = true;
          preSolarCamPos = camera.position.clone();
          preSolarTarget = controls.target.clone();
          setCameraAnimation(solarViewpoint.position, solarViewpoint.target, 1200);
          if (hideTooltip) hideTooltip();

          const sc = config.solarConfig!;
          const footerPanels = document.getElementById('solarFooterPanels');
          const footerKwp = document.getElementById('solarFooterKwp');
          const footerArea = document.getElementById('solarFooterArea');
          if (footerPanels) footerPanels.textContent = `${sc.panels} Panels`;
          if (footerKwp) footerKwp.textContent = `${sc.kWp} kWp`;
          if (footerArea) footerArea.textContent = `${sc.areaM2} m²`;

          solarDash.classList.add('is-visible');

          const countStart = performance.now();
          const countDuration = 1800;
          const totalTarget = sc.totalKWh;
          let totalValue = 0;
          let lastTickTime = performance.now();

          const tickSolar = () => {
            if (!solarViewActive) return;
            const now = performance.now();
            const elapsed = now - countStart;
            const t = Math.min(elapsed / countDuration, 1);
            const ease = easeInOutCubic(t);

            if (t < 1) {
              solarOutputEl.textContent = (sc.nominalOutputKW * ease).toFixed(1);
              solarPerM2El.textContent = (sc.nominalPerM2 * ease).toFixed(1);
              solarEffEl.textContent = (sc.efficiency * ease).toFixed(1);
              totalValue = totalTarget * ease;
            } else {
              const flux = Math.sin(now * 0.0015) * 0.3
                         + Math.sin(now * 0.004) * 0.2
                         + Math.sin(now * 0.0008) * 0.1;
              solarOutputEl.textContent = (sc.nominalOutputKW + flux).toFixed(1);
              solarPerM2El.textContent = (sc.nominalPerM2 + flux * 10.42).toFixed(1);
              const dt = (now - lastTickTime) / 1000;
              totalValue += 0.15 * dt;
            }

            lastTickTime = now;
            solarTotalEl.textContent = fmtTotal(totalValue);
            solarTickerId = requestAnimationFrame(tickSolar);
          };
          solarTickerId = requestAnimationFrame(tickSolar);
        };

        const deactivateSolarView = () => {
          if (!solarViewActive) return;
          solarViewActive = false;
          cancelAnimationFrame(solarTickerId);
          solarDash.classList.remove('is-visible');
          if (preSolarCamPos && preSolarTarget) {
            setCameraAnimation(preSolarCamPos, preSolarTarget, 1000);
          }
          solarOutputEl.textContent = '0.0';
          solarPerM2El.textContent = '0.0';
          solarTotalEl.textContent = '0.0';
          solarEffEl.textContent = '0.0';
        };

        deactivateSolar = deactivateSolarView;

        const solarCloseHandler = (e: MouseEvent) => {
          e.stopPropagation();
          deactivateSolarView();
        };
        solarDashClose?.addEventListener('click', solarCloseHandler);

        const raycastRooftop = (clientX: number, clientY: number): boolean => {
          const rect = viewport.getBoundingClientRect();
          pointerNDC.x = ((clientX - rect.left) / rect.width) * 2 - 1;
          pointerNDC.y = -((clientY - rect.top) / rect.height) * 2 + 1;
          raycaster.setFromCamera(pointerNDC, camera);
          const hits = raycaster.intersectObject(model, true);
          return hits.length > 0 && hits[0].point.y > rooftopThresholdY;
        };

        if (hasHover) {
          // Desktop: hover tooltip + click to activate solar view
          const solarTooltip = document.getElementById('solarTooltip') as HTMLDivElement;
          let tooltipVisible = false;

          const showTooltip = (screenX: number, screenY: number) => {
            solarTooltip.style.left = `${screenX}px`;
            solarTooltip.style.top = `${screenY}px`;
            if (!tooltipVisible) {
              solarTooltip.classList.add('is-visible');
              viewport.style.cursor = 'pointer';
              tooltipVisible = true;
            }
          };

          hideTooltip = () => {
            if (!tooltipVisible) return;
            solarTooltip.classList.remove('is-visible');
            viewport.style.cursor = '';
            tooltipVisible = false;
          };

          onPointerMove = (e: PointerEvent) => {
            if (solarViewActive) { hideTooltip(); return; }
            const rect = viewport.getBoundingClientRect();
            pointerNDC.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
            pointerNDC.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

            raycaster.setFromCamera(pointerNDC, camera);
            const hits = raycaster.intersectObject(model, true);

            if (hits.length > 0 && hits[0].point.y > rooftopThresholdY) {
              const projected = hits[0].point.clone().project(camera);
              const sx = (projected.x * 0.5 + 0.5) * rect.width;
              const sy = (-projected.y * 0.5 + 0.5) * rect.height;
              showTooltip(sx, sy);
              return;
            }

            hideTooltip();
          };

          const clickHandler = (e: PointerEvent) => {
            if (solarViewActive) return;
            if (raycastRooftop(e.clientX, e.clientY)) {
              activateSolarView();
            }
          };

          viewport.addEventListener('pointermove', onPointerMove);
          viewport.addEventListener('pointerleave', hideTooltip);
          viewport.addEventListener('click', clickHandler);

          removeSolarListeners = () => {
            viewport.removeEventListener('pointermove', onPointerMove);
            viewport.removeEventListener('pointerleave', hideTooltip);
            viewport.removeEventListener('click', clickHandler);
            solarDashClose?.removeEventListener('click', solarCloseHandler);
          };
        } else {
          // Mobile: pulsing hotspot on rooftop + tap to activate solar view
          const hotspot = document.getElementById('solarHotspot') as HTMLDivElement;
          const hotspotWorldPos = new THREE.Vector3(0, size.y * 0.42, 0);
          const projectedHotspot = new THREE.Vector3();

          let lastHotspotX = -1;
          let lastHotspotY = -1;
          let hotspotVisible = false;

          updateHotspotPosition = () => {
            if (solarViewActive) {
              if (hotspotVisible) {
                hotspot.classList.remove('is-visible');
                hotspotVisible = false;
              }
              return;
            }
            projectedHotspot.copy(hotspotWorldPos).project(camera);
            if (projectedHotspot.z > 1) {
              if (hotspotVisible) {
                hotspot.classList.remove('is-visible');
                hotspotVisible = false;
              }
              return;
            }
            const hx = (projectedHotspot.x * 0.5 + 0.5) * cachedVW;
            const hy = (-projectedHotspot.y * 0.5 + 0.5) * cachedVH;
            if (Math.abs(hx - lastHotspotX) > 0.5 || Math.abs(hy - lastHotspotY) > 0.5) {
              hotspot.style.transform = `translate3d(${hx - 5}px, ${hy - 5}px, 0)`;
              lastHotspotX = hx;
              lastHotspotY = hy;
            }
            if (!hotspotVisible) {
              hotspot.classList.add('is-visible');
              hotspotVisible = true;
            }
          };

          let touchStart: { x: number; y: number; t: number } | null = null;

          const touchDownHandler = (e: PointerEvent) => {
            if (e.pointerType !== 'touch') return;
            touchStart = { x: e.clientX, y: e.clientY, t: performance.now() };
          };
          const touchUpHandler = (e: PointerEvent) => {
            if (e.pointerType !== 'touch' || !touchStart) return;
            const dx = e.clientX - touchStart.x;
            const dy = e.clientY - touchStart.y;
            const moved = Math.sqrt(dx * dx + dy * dy);
            const elapsed = performance.now() - touchStart.t;
            touchStart = null;

            if (moved > 12 || elapsed > 350) return;

            if (solarViewActive) return;
            if (raycastRooftop(e.clientX, e.clientY)) {
              activateSolarView();
            }
          };

          viewport.addEventListener('pointerdown', touchDownHandler);
          viewport.addEventListener('pointerup', touchUpHandler);

          removeSolarListeners = () => {
            viewport.removeEventListener('pointerdown', touchDownHandler);
            viewport.removeEventListener('pointerup', touchUpHandler);
            solarDashClose?.removeEventListener('click', solarCloseHandler);
            updateHotspotPosition = null;
          };
        }
        } // end config.hasSolar

        // --- Wire interactive controls ---
        const btnWireframe = document.getElementById('btnWireframe') as HTMLButtonElement | null;
        const btnReset = document.getElementById('btnReset') as HTMLButtonElement | null;

        let wireframeOn = false;
        const wireframeHandler = () => {
          wireframeOn = !wireframeOn;
          btnWireframe?.classList.toggle('is-active', wireframeOn);
          for (const child of allMeshes) {
            const mats = Array.isArray(child.material) ? child.material : [child.material];
            mats.forEach((m: any) => { m.wireframe = wireframeOn; });
          }
        };
        const resetHandler = () => {
          if (!initialCamPos || !initialTarget) return;
          setCameraAnimation(initialCamPos, initialTarget, 800);
        };
        btnWireframe?.addEventListener('click', wireframeHandler);
        btnReset?.addEventListener('click', resetHandler);
        controlHandlers.push({
          remove: () => {
            btnWireframe?.removeEventListener('click', wireframeHandler);
            btnReset?.removeEventListener('click', resetHandler);
          },
        });

        if (loader) {
          loader.classList.add('is-hidden');
        }
      },
      (progress) => {
        if (progress.total > 0 && loaderText) {
          const pct = Math.round((progress.loaded / progress.total) * 100);
          loaderText.textContent = `Loading model… ${pct}%`;
        }
      },
      (error) => {
        console.error('GLB load error:', error);
        if (loaderText) {
          loaderText.textContent = 'Failed to load model';
        }
      }
    );
    }

    document.getElementById('tabLeventis')?.addEventListener('click', () => loadModel('leventis'));
    document.getElementById('tabCtf01')?.addEventListener('click', () => loadModel('ctf01'));
    document.getElementById('tabSocialsquare')?.addEventListener('click', () => loadModel('socialsquare'));

    loadModel('leventis');

    function easeInOutCubic(t: number): number {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    let animFrameId = 0;
    let isModelVisible = true;

    const visibilityObs = new IntersectionObserver(([e]) => {
      isModelVisible = e.isIntersecting;
      if (isModelVisible && !animFrameId) animate();
    });
    visibilityObs.observe(viewport);

    function animate() {
      if (!isModelVisible) { animFrameId = 0; return; }
      animFrameId = requestAnimationFrame(animate);

      if (resetAnim) {
        const elapsed = performance.now() - resetAnim.start;
        const t = Math.min(elapsed / resetAnim.duration, 1);
        const ease = easeInOutCubic(t);

        camera.position.lerpVectors(resetAnim.fromPos, resetAnim.toPos, ease);
        controls.target.lerpVectors(resetAnim.fromTarget, resetAnim.toTarget, ease);

        if (t >= 1) resetAnim = null;
      }

      if (performance.now() - lastCullUpdate > 500) {
        updateDistanceCulling();
        lastCullUpdate = performance.now();
      }

      controls.update();
      if (updateHotspotPosition) updateHotspotPosition();

      renderer.render(scene, camera);
    }
    animate();

    const ro = new ResizeObserver(resize);
    ro.observe(viewport);

    const cleanup = () => {
      if (deactivateSolar) deactivateSolar();
      if (removeSolarListeners) removeSolarListeners();
      cancelAnimationFrame(animFrameId);
      visibilityObs.disconnect();
      ro.disconnect();
      if (currentModel) {
        scene.remove(currentModel);
        currentModel.traverse((obj: any) => {
          if (obj.isMesh) {
            obj.geometry?.dispose();
            const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
            mats.forEach((m: any) => m?.dispose?.());
          }
        });
      }
      if (currentGrid) {
        scene.remove(currentGrid);
        (currentGrid.material as InstanceType<typeof THREE.Material>)?.dispose?.();
      }
      controls.dispose();
      dracoLoader.dispose();
      renderer.dispose();
    };
    window.addEventListener('pagehide', cleanup, { once: true });
    },
    { rootMargin: '100px' }
  );

    observer.observe(viewport);
  }
</script>
