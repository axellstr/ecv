---
const services = [
  {
    title: '3D Reconstruction',
    description: '3D Reconstruction of an area, individual building or smaller scale objects using Laser Scanning and Terrestrial and Aerial Photogrammetry processes.',
    image: '/one.png',
  },
  {
    title: 'Data Visualization',
    description: 'Data visualization of IOT connected devices and sensors – augmentation of generated 3D models through dynamic and static data and metadata.',
    image: '',
  },
  {
    title: 'Simulations',
    description: 'Capability to run a series of simulation on the generated models, including crowd, traffic weather, light and more.',
    image: '/sim.png',
  },
  {
    title: 'Cultural Heritage',
    description: 'Heritage site capture and documentation.',
    image: '/cy.png',
  },
  {
    title: 'AR/VR Estate',
    description: 'Augmented and virtual reality solutions for real estate visualization, virtual property tours, and immersive showcases.',
    image: '/estate.png',
  },
  {
    title: 'Interactive Geospatial Models',
    description: 'Generation of Interactive models for wide range of applications.',
    image: '',
  },
];
---

<section id="solutions" class="services">
  <div class="services__inner">
    <h2 class="services__title">Solutions</h2>
    <p class="services__description">
      We deliver end-to-end solutions that leverage spatial technology and AI to transform how organisations navigate,
      preserve, and present their environments.
    </p>
    <ul class="services__list" role="list">
      {services.map((service) => (
        <li class="services__item">
          <div class="services__item-image">
            {service.image ? (
              <img src={service.image} alt={service.title} loading="lazy" />
            ) : (
              <div class="services__item-image-placeholder" aria-hidden="true" />
            )}
          </div>
          <div class="services__item-content">
            <h3 class="services__item-title">{service.title}</h3>
            <p class="services__item-desc">{service.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    min-height: 100vh;
    padding: var(--s-8);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--c-surface);
  }

  @media (max-width: 480px) {
    .services {
      padding: var(--s-6) var(--s-5);
    }
  }

  .services__inner {
    width: 100%;
    max-width: 42rem;
    text-align: left;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 769px) {
    .services__inner {
      max-width: 66rem;
      text-align: left;
    }
  }

  .services__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0 0 var(--s-6);
    color: var(--c-text);
    text-transform: uppercase;
  }

  @media (min-width: 769px) {
    .services__title {
      font-size: clamp(3rem, 6vw, 4.5rem);
      letter-spacing: -0.02em;
      margin-bottom: var(--s-8);
    }
  }

  .services__description {
    margin: 0 0 var(--s-10);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.01em;
    color: var(--c-text-muted);
    max-width: 42ch;
  }

  @media (min-width: 769px) {
    .services__description {
      font-size: 1.1875rem;
      line-height: 1.55;
      color: var(--c-text);
      margin-bottom: var(--s-12);
      max-width: 48ch;
    }
  }

  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-8);
  }

  @media (min-width: 769px) {
    .services__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-10);
    }
  }

  @media (min-width: 1024px) {
    .services__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .services__item {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-6);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: border-color 0.3s ease;
  }

  .services__item:hover {
    border-color: rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 768px) {
    .services__item {
      padding: var(--s-4);
      gap: var(--s-3);
    }
    .services__item-title {
      font-size: var(--text-base);
    }
    .services__item-desc {
      font-size: var(--text-sm);
    }
  }

  .services__item-image {
    flex-shrink: 0;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--c-bg);
  }

  @media (max-width: 768px) {
    .services__item-image {
      aspect-ratio: 16 / 9;
    }
  }

  .services__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .services__item-image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--c-bg) 0%, var(--c-border) 100%);
    opacity: 0.5;
  }

  .services__item-content {
    display: flex;
    flex-direction: column;
    min-width: 0;
    text-align: left;
  }

  .services__item-title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    margin: 0 0 var(--s-3);
    color: var(--c-text);
  }

  .services__item-desc {
    margin: 0;
    font-size: var(--text-base);
    color: var(--c-text-muted);
    line-height: 1.6;
  }
</style>
