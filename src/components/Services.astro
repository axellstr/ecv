---
import { Image } from 'astro:assets';

import imgOne from '../assets/services/one.png';
import imgData from '../assets/services/data.png';
import imgSim from '../assets/services/sim.png';
import imgCy from '../assets/services/cy.png';
import imgEstate from '../assets/services/estate.png';
import imgGeo from '../assets/services/geo.png';

const services = [
  {
    title: '3D Reconstruction',
    description: '3D Reconstruction of an area, individual building or smaller scale objects using Laser Scanning and Terrestrial and Aerial Photogrammetry processes.',
    image: imgOne,
  },
  {
    title: 'Data Visualization',
    description: 'Data visualization of IOT connected devices and sensors – augmentation of generated 3D models through dynamic and static data and metadata.',
    image: imgData,
  },
  {
    title: 'Simulations',
    description: 'Capability to run a series of simulation on the generated models, including crowd, traffic weather, light and more.',
    image: imgSim,
  },
  {
    title: 'Cultural Heritage',
    description: 'Heritage site capture and documentation.',
    image: imgCy,
  },
  {
    title: 'AR/VR Estate',
    description: 'Augmented and virtual reality solutions for real estate visualization, virtual property tours, and immersive showcases.',
    image: imgEstate,
  },
  {
    title: 'Interactive Geospatial Models',
    description: 'Generation of Interactive models for wide range of applications.',
    image: imgGeo,
  },
];
---

<section id="solutions" class="services">
  <div class="services__inner">
    <h2 class="services__title">Solutions</h2>
    <p class="services__description">
      We deliver end-to-end solutions that leverage spatial technology and AI to transform how organisations navigate,
      preserve, and present their environments.
    </p>
    <ul class="services__list" role="list">
      {services.map((service) => (
        <li class="services__item">
          <div class="services__item-image">
            <Image
              src={service.image}
              alt={service.title}
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 90vw, (max-width: 1024px) 45vw, 30vw"
              loading="lazy"
              class="services__item-img"
            />
          </div>
          <div class="services__item-content">
            <h3 class="services__item-title">{service.title}</h3>
            <p class="services__item-desc">{service.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    min-height: 100vh;
    padding: var(--s-16) var(--s-8);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--c-surface);
    border-top: 1px solid var(--c-border);
  }

  @media (max-width: 480px) {
    .services {
      padding: var(--s-12) var(--s-5);
    }
  }

  @media (min-width: 769px) {
    .services {
      padding: var(--s-24) var(--s-8);
    }
  }

  .services__inner {
    width: 100%;
    max-width: 42rem;
    text-align: left;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 769px) {
    .services__inner {
      max-width: 66rem;
    }
  }

  .services__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0 0 var(--s-6);
    color: var(--c-text);
    text-transform: uppercase;
  }

  @media (min-width: 769px) {
    .services__title {
      font-size: clamp(3rem, 6vw, 4.5rem);
      letter-spacing: -0.02em;
      margin-bottom: var(--s-10);
    }
  }

  .services__description {
    margin: 0 0 var(--s-10);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.6;
    color: var(--c-text-muted);
  }

  @media (min-width: 769px) {
    .services__description {
      font-size: var(--text-2xl);
      line-height: 1.55;
      color: var(--c-text-sub);
      margin-bottom: var(--s-16);
      max-width: 44rem;
    }
  }

  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
  }

  @media (min-width: 769px) {
    .services__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-6);
    }
  }

  @media (min-width: 1024px) {
    .services__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .services__item {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-5);
    background: var(--c-surface-elevated);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    overflow: hidden;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-slow) var(--ease-out);
  }

  .services__item:hover {
    border-color: var(--c-border-hover);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 768px) {
    .services__item {
      padding: var(--s-4);
      gap: var(--s-3);
    }
    .services__item-title {
      font-size: var(--text-base);
    }
    .services__item-desc {
      font-size: var(--text-sm);
    }
  }

  .services__item-image {
    flex-shrink: 0;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--c-bg);
  }

  @media (max-width: 768px) {
    .services__item-image {
      aspect-ratio: 16 / 9;
    }
  }

  .services__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .services__item:hover .services__item-image img {
    transform: scale(1.03);
  }

  .services__item-image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--c-bg) 0%, var(--c-border) 100%);
    opacity: 0.5;
  }

  .services__item-content {
    display: flex;
    flex-direction: column;
    min-width: 0;
    text-align: left;
    padding-top: var(--s-1);
  }

  .services__item-title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    margin: 0 0 var(--s-3);
    color: var(--c-text);
    letter-spacing: -0.01em;
  }

  .services__item-desc {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    line-height: 1.65;
  }
</style>
